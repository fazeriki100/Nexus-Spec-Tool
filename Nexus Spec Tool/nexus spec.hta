<!DOCTYPE html>
<html>
<head>
    <title>Nexus System Spec Tool</title>
    <!-- Configura la finestra dell'applicazione -->
    <hta:application 
        id="nexusSpec"
        border="thick"
        borderStyle="normal"
        caption="yes"
        maximizeButton="no"
        minimizeButton="yes"
        sysMenu="yes"
        windowState="normal"
        scroll="no"
    />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1e1e24;
            color: #f5f5f5;
            margin: 20px;
            text-align: center;
        }
        h1 {
            color: #00adb5;
            font-size: 22px;
            margin-bottom: 5px;
        }
        p {
            color: #eeeeee;
            font-size: 14px;
            margin-bottom: 20px;
        }
        .btn {
            background-color: #00adb5;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
        }
        .btn:hover {
            background-color: #007a80;
        }
        #output {
            margin-top: 20px;
            background-color: #222831;
            border: 1px solid #393e46;
            border-radius: 5px;
            padding: 15px;
            text-align: left;
            font-family: monospace;
            font-size: 13px;
            height: 200px;
            overflow-y: auto;
            white-space: pre-wrap;
        }
    </style>

    <script language="VBScript">
        ' Ridimensiona la finestra all'avvio
        Sub Window_OnLoad
            window.resizeTo 550, 500
        End Sub

        ' Funzione che esegue i comandi quando clicchi il pulsante
        Sub ScanHardware
            document.getElementById("output").innerHTML = "Scanning components... Please wait..."
            
            Set objShell = CreateObject("WScript.Shell")
            
            ' Esegue il comando per la CPU
            Set objExec = objShell.Exec("wmic cpu get name")
            strCPU = objExec.StdOut.ReadAll
            strCPU = Replace(strCPU, "Name", "")
            
            ' Esegue il comando per la Scheda Madre
            Set objExec = objShell.Exec("wmic baseboard get manufacturer, product")
            strBase = objExec.StdOut.ReadAll
            strBase = Replace(strBase, "Manufacturer", "")
            strBase = Replace(strBase, "Product", "")

            ' Compone il testo finale da mostrare nella finestra
            strFinal = "=== PROCESSOR ===" & vbCrLf & Trim(strCPU) & vbCrLf & vbCrLf & _
                       "=== MOTHERBOARD ===" & vbCrLf & Trim(strBase)
                       
            document.getElementById("output").innerHTML = strFinal
        End Sub
    </script>
</head>
<body>

    <h1>NEXUS SYSTEM SPEC TOOL</h1>
    <p>Click the button below to scan your hardware components.</p>
    
    <!-- Il pulsante che avvia lo scan -->
    <button class="btn" onclick="ScanHardware()">SCAN SYSTEM</button>
    
    <!-- Il riquadro scuro dove appaiono i risultati -->
    <div id="output">Hardware specifications will appear here...</div>

</body>
</html>
